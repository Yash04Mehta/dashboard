# Copy this file to ".env" to change settings. Nothing here is needed to run on the CSV exports.

# --- Live database (leave commented to use the CSV exports in ../data_insight) ---
# A READ-ONLY login. See README, "Connecting the live database". Never commit or share the real value.
# PGHOST=your-db-host
# PGPORT=5432
# PGDATABASE=your_db
# PGUSER=dashboard_ro
# PGPASSWORD=CHANGE_ME     # or one DATABASE_URL=postgres://dashboard_ro:CHANGE_ME@your-db-host:5432/your_db
# PGSSL=disable            # only if your database does not use SSL

# --- CSV mode ---
# DATA_DIR=C:\path\to\folder\with\the\five\csv\files

# --- Privacy ---
# ALLOW_REVEAL=false       # true (default) lets a user switch on full phone numbers and message text for one customer

# --- Server ---
# PORT=8787

# --- Hosting on Netlify (set these in Netlify > Environment variables, NOT in a file) ---
# DATABASE_URL (or PGHOST/PGUSER/PGPASSWORD/PGDATABASE), DEMO_USER, DEMO_PASS (not the default), SESSION_SECRET (32+ random characters). See README, "Hosting on Netlify".
